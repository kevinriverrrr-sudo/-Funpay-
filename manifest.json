{
  "manifest_version": 3,
  "name": "FunPay Customizer",
  "version": "1.0.0",
  "description": "Расширение для кастомизации внешнего вида сайта FunPay.com",
  "author": "@MarkusGarantor",
  "permissions": [
    "storage",
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "https://funpay.com/*",
    "https://*.funpay.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://funpay.com/*",
        "https://*.funpay.com/*"
      ],
      "js": ["content/content.js", "content/features/lotsExport.js"],
      "css": ["content/inject.css"],
      "run_at": "document_start"
    }
  ],
  "options_page": "options/options.html",
  "web_accessible_resources": [
    {
      "resources": ["assets/fonts/*", "assets/themes/*"],
      "matches": ["https://funpay.com/*", "https://*.funpay.com/*"]
    }
  ]
}
