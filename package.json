{
  "name": "funpay-customizer",
  "version": "1.0.0",
  "description": "Браузерное расширение для кастомизации сайта FunPay.com",
  "main": "manifest.json",
  "scripts": {
    "test": "echo \"No tests specified yet\" && exit 0",
    "lint": "echo \"Linting not configured yet\" && exit 0",
    "build": "echo \"Building extension...\" && npm run create-zip",
    "create-zip": "zip -r funpay-customizer.zip . -x '*.git*' -x 'node_modules/*' -x '*.zip' -x 'package*.json' -x 'assets/icons/*.js' -x 'assets/icons/*.sh' -x 'assets/icons/*.svg' -x 'Д'"
  },
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "customization",
    "themes",
    "funpay"
  ],
  "author": "FunPay Customizer Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/funpay-customizer.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/funpay-customizer/issues"
  },
  "homepage": "https://github.com/yourusername/funpay-customizer#readme"
}
